NODE_ENV=development

API_PORT=3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=holocron
POSTGRES_USER=holocron
POSTGRES_PASSWORD=holocron

# CORS origin used by the API for the SPA + Socket.io
WEB_ORIGIN=http://localhost:5173

# Auth — see docs/auth-and-sessions.md
# Required. Generate with `openssl rand -hex 32`. Min 16 chars.
JWT_SECRET=change-me-to-a-32-byte-hex-secret
# Optional. Admin browser session lifetime; admins re-log on expiry.
JWT_ADMIN_TTL=12h

# Optional. Bootstraps the first admin user on a fresh database.
# These env vars are ignored once any admin exists in the users table.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login
BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin

# Router enforcement. Both required; the API fails at startup
# if either is missing. Point at the EdgeRouter X HTTP service; the bearer
# is a static key shared with the router-side daemon.
ROUTER_BASE_URL=http://192.168.1.1:8080
ROUTER_BEARER_TOKEN=change-me

# PiHole enforcement (ADR-0006). Base URL + API password are required; the
# API fails at startup if either is missing or if the configured group
# names cannot be resolved against the PiHole instance. Used to enforce
# `entertainment` and `games` restriction scopes via DNS group membership.
PIHOLE_BASE_URL=http://pi.hole
PIHOLE_API_PASSWORD=change-me
# Optional. Override the PiHole group names used for each scope.
# Defaults shown; the groups must exist on the PiHole instance.
PIHOLE_GAMES_GROUP_NAME=blocked-games-dynamic
PIHOLE_STREAMING_GROUP_NAME=blocked-streaming-dynamic
# Dev only. Set to true to swap the router + PiHole transports for in-memory
# fakes so the API boots without either on the network (the URL/password vars
# above are then ignored). Also handy for trying Holocron without a router or
# Pi-hole, but nothing is blocked, so don't leave it on for real use.
# FAKE_ENFORCEMENT=true

# ---------------------------------------------------------------------------
# Home surface — Home Assistant controls + Scrypted cameras (see
# docs/home-surface.md). The whole panel is OPTIONAL and has two independently
# optional halves:
#   • HA controls  — enabled when HA_BASE_URL + HA_TOKEN are both set.
#   • Cameras      — enabled when SCRYPTED_CAMERAS holds at least one camera.
# Everything below is commented out: with neither half set, the tablet shows no
# home panel at all and the /ha routes do not exist. Uncomment what you use.
# Every entity below is reached only if explicitly named here — the tablet can
# touch nothing else on your HA instance.
# ---------------------------------------------------------------------------

# --- Home Assistant controls ---
# LAN URL of your HA instance (no trailing slash) and a dedicated long-lived
# access token (HA → profile → "Long-lived access tokens"). The token never
# leaves the API; the tablet calls the API, the API calls HA.
# HA_BASE_URL=http://homeassistant.local:8123
# HA_TOKEN=change-me-long-lived-token

# "Currently on" list. Domains counted as on-able (default `light,switch`) and
# entity_id patterns to drop (default `*led`, e.g. status LEDs). `*led`/`*_led`
# match; dots are literal. Set HA_ONLIST_EXCLUDE= (empty) for no excludes.
# HA_ONLIST_INCLUDE=light,switch
# HA_ONLIST_EXCLUDE=*led

# Optional control panels — each appears only when its entity is set AND the
# entity exists on HA. Leave unset to hide that panel.
# HA_CLIMATE_ENTITY=climate.house          # thermostat ± nudge
# HA_FAN_ENTITY=fan.house_fan              # house-fan Off/Low/High
# HA_WEATHER_ENTITY=weather.home           # current temp + forecast
# HA_CO2_ENTITY=sensor.indoor_co2          # CO₂ readout

# House-fan state→service map. Defaults assume a PRESET-MODE fan:
#   off  → fan.turn_off
#   low  → fan.set_preset_mode {preset_mode: "low"}
#   high → fan.set_preset_mode {preset_mode: "high"}
# IMPORTANT: preset names are case-sensitive and hardware-specific. If changing
# the fan errors (the API log shows the HA reason, e.g. "Preset mode low is not
# valid, valid preset modes are: ['Auto','Low','High']"), override the offending
# state(s) here. Any subset is merged over the defaults. Examples:
#   Capitalised presets:
#     HA_FAN_SERVICES={"low":{"service":"fan.set_preset_mode","data":{"preset_mode":"Low"}},"high":{"service":"fan.set_preset_mode","data":{"preset_mode":"High"}}}
#   Percentage fan (no preset modes — 0/50/100):
#     HA_FAN_SERVICES={"off":{"service":"fan.set_percentage","data":{"percentage":0}},"low":{"service":"fan.set_percentage","data":{"percentage":50}},"high":{"service":"fan.set_percentage","data":{"percentage":100}}}
# HA_FAN_SERVICES=

# Scene controls (optional, comma-separated entity ids).
# HA_SCENE_BUTTONS=button.clean_kitchen     # momentary button.press
# HA_SCENE_BOOLEANS=input_boolean.night_mode # stateful on/off toggle

# Read-only doorbell binary_sensor. Its off→on edge opens the doorbell glance
# on the tablet. Unset ⇒ no doorbell feature.
# HA_DOORBELL_ENTITY=binary_sensor.front_door_binarysensor

# --- Scrypted cameras ---
# JSON array of cameras. `urlTemplate` is an unauthenticated `hotlink-ok`
# snapshot URL (served via HA's reverse proxy) with `{ts}` (cache-buster) and
# `{width}` placeholders the tablet fills in — the API never touches image
# bytes or holds a camera credential. Mark the doorbell camera with
# `"doorbell": true`. Empty/unset ⇒ no camera UI.
# SCRYPTED_CAMERAS=[{"id":"front","name":"Front door","doorbell":true,"urlTemplate":"http://homeassistant.local:8123/api/scrypted/front/snapshot?ts={ts}&width={width}"},{"id":"driveway","name":"Driveway","urlTemplate":"http://homeassistant.local:8123/api/scrypted/driveway/snapshot?ts={ts}&width={width}"}]
# Canonical width requested from every hotlink URL (one server-side resize per
# fresh frame; each tile downscales in CSS). Default 768.
# SCRYPTED_SNAPSHOT_WIDTH=768
